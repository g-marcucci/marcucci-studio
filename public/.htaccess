# Configuração do Apache/LiteSpeed da Hostinger para o site estático.

Options -Indexes
DirectorySlash On
ErrorDocument 404 /404.html

# Páginas do site anterior (/work/...) que não existem mais: vão para o início.
RedirectMatch 301 ^/work/(nubank-private|vao-arquitetura|barro|automation-platform)/?$ /

# O case em português ficava em /trabalhos/...; hoje fica em /pt/trabalhos/...
RedirectMatch 301 ^/trabalhos/erp-multimarketplace/?$ /pt/trabalhos/erp-multimarketplace/

# Arquivos com hash no nome (_next/static) nunca mudam: cache longo.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
